# 复制为 .env 后填写（cp .env.example .env）。.env 已被 .gitignore 忽略，不会进版本库。
# 全部留空也能跑：默认走 heuristic 抽取 + 内置合成目录，不需要任何外部服务。

# --- 分类目录 ---
# 留空则使用 packages/mc-domain/src/mc_domain/data/catalog_sample.csv（合成目录，仅供测试）
# 真实目录：python scripts/crawl_catalog.py --all --csv data/raw/catalog_real.csv
# 留空则自动选择：存在 data/raw/catalog_real.csv 就用它，否则退回内置合成目录
MC_CATALOG_VERSION=

# --- 槽位抽取 ---
# heuristic = 关键词基线，离线可跑（默认）
# llm       = 走 OpenAI 兼容接口；抽取失败会返回 502，不会降级成空画像
MC_NORMALIZER=heuristic

# 仅当 MC_NORMALIZER=llm 时需要，三者都必填，缺一项启动就会失败
MC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MC_LLM_API_KEY=
MC_LLM_MODEL=qwen-plus
MC_LLM_TIMEOUT_S=30
MC_LLM_MAX_RETRIES=2

# --- 重排序（可选；未配置时自动跳过，不影响启动）---
# 注意：rerank 不走 OpenAI 兼容层，是 DashScope 原生接口
MC_RERANK_MODEL=qwen3-rerank
MC_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# --- 向量检索（可选；未配置时用字符 bigram 基线）---
MC_EMBEDDING_MODEL=text-embedding-v4
MC_EMBEDDING_DIM=1024
MC_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 调试 ---
MC_DEBUG=false
